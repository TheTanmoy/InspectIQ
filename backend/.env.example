# Copy to .env and fill in on the day. NEVER commit .env.

# ---- LLM: openai | azure | anthropic | gemini | mock
# Most organiser gateways are OpenAI-compatible -> use "openai" + their base URL (ending in /v1).
LLM_PROVIDER=gemini
LLM_API_KEY=
#LLM_BASE_URL=
# Azure: this is the deployment name
LLM_MODEL=gemini-3.8-flash
# Used automatically if the primary model errors or does not answer within LLM_PRIMARY_TIMEOUT seconds
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_PRIMARY_TIMEOUT=15
AZURE_API_VERSION=2024-06-01
# true only if the provided model accepts images (sends defect photos with the report prompt)
LLM_VISION=false

LLM_TEMPERATURE=0.3
REPORT_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60
LLM_RATE_LIMIT_PER_MIN=20
# Set to false only if a corporate proxy breaks SSL
VERIFY_SSL=true

# ---- App
APP_TITLE=InspectIQ
# Any long random string - keeps users logged in across restarts
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=3
# "synthetic" = local generated data, or the base URL of a real inspection API
INSPECTION_SOURCE=synthetic
